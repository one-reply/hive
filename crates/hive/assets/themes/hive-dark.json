{
  "name": "Hive Dark",
  "mode": "dark",
  "colors": {
    "tab_bar.background": "#111111",
    "overlay": "#00000080",
    "background": "#0a0a0a",
    "foreground": "#fafafa"
  },
  "highlight": {
    "syntax": {
      "attribute": {
        "color": "#F7A76C",
        "font_style": "italic"
      },
      "boolean": {
        "color": "#FF8FB1"
      },
      "comment": {
        "color": "#6B7394",
        "font_style": "italic"
      },
      "comment.doc": {
        "color": "#7E88AA",
        "font_style": "italic"
      },
      "constant": {
        "color": "#FF8FB1"
      },
      "constructor": {
        "color": "#FFCB6B"
      },
      "embedded": {
        "color": "#D6DEEB"
      },
      "enum": {
        "color": "#FFCB6B"
      },
      "function": {
        "color": "#82AAFF"
      },
      "keyword": {
        "color": "#C792EA"
      },
      "label": {
        "color": "#FFCB6B"
      },
      "number": {
        "color": "#FF8FB1"
      },
      "operator": {
        "color": "#89DDFF"
      },
      "preproc": {
        "color": "#C792EA"
      },
      "property": {
        "color": "#7FDBCA"
      },
      "punctuation": {
        "color": "#9AA3C7"
      },
      "punctuation.bracket": {
        "color": "#9AA3C7"
      },
      "punctuation.delimiter": {
        "color": "#9AA3C7"
      },
      "punctuation.special": {
        "color": "#89DDFF"
      },
      "string": {
        "color": "#C3E88D"
      },
      "string.escape": {
        "color": "#89DDFF"
      },
      "string.regex": {
        "color": "#89DDFF"
      },
      "string.special": {
        "color": "#C3E88D"
      },
      "string.special.symbol": {
        "color": "#C3E88D"
      },
      "tag": {
        "color": "#F07178"
      },
      "type": {
        "color": "#FFCB6B"
      },
      "variable": {
        "color": "#D6DEEB"
      },
      "variable.special": {
        "color": "#C792EA",
        "font_style": "italic"
      },
      "variant": {
        "color": "#FF8FB1"
      }
