{
  "name": "Hive Light",
  "mode": "light",
  "colors": {
    "sidebar.background": "#ffffff",
    "background": "#ffffff",
    "foreground": "#0a0a0a"
  },
  "highlight": {
    "syntax": {
      "attribute": {
        "color": "#B45309",
        "font_style": "italic"
      },
      "boolean": {
        "color": "#BE185D"
      },
      "comment": {
        "color": "#7C8599",
        "font_style": "italic"
      },
      "comment.doc": {
        "color": "#6B7489",
        "font_style": "italic"
      },
      "constant": {
        "color": "#BE185D"
      },
      "constructor": {
        "color": "#9A6700"
      },
      "embedded": {
        "color": "#24292F"
      },
      "enum": {
        "color": "#9A6700"
      },
      "function": {
        "color": "#1D4ED8"
      },
      "keyword": {
        "color": "#7C3AED"
      },
      "label": {
        "color": "#9A6700"
      },
      "number": {
        "color": "#BE185D"
      },
      "operator": {
        "color": "#0E7490"
      },
      "preproc": {
        "color": "#7C3AED"
      },
      "property": {
        "color": "#0F766E"
      },
      "punctuation": {
        "color": "#57606A"
      },
      "punctuation.bracket": {
        "color": "#57606A"
      },
      "punctuation.delimiter": {
        "color": "#57606A"
      },
      "punctuation.special": {
        "color": "#0E7490"
      },
      "string": {
        "color": "#15803D"
      },
      "string.escape": {
        "color": "#0E7490"
      },
      "string.regex": {
        "color": "#0E7490"
      },
      "string.special": {
        "color": "#15803D"
      },
      "string.special.symbol": {
        "color": "#15803D"
      },
      "tag": {
        "color": "#C62828"
      },
      "type": {
        "color": "#9A6700"
      },
      "variable": {
        "color": "#24292F"
      },
      "variable.special": {
        "color": "#7C3AED",
        "font_style": "italic"
      },
      "variant": {
        "color": "#BE185D"
      }
    }
  },
  "terminal": {
    "background": "#ffffff",
    "foreground": "#0a0a0a",
    "cursor": "#0a0a0a",
    "selection": "#0a0a0a4d",
    "ansi": [
      "#000000",
      "#c91b00",
      "#00a600",
      "#999900",
      "#0225c7",
      "#ca30c7",
      "#00a6b2",
      "#bfbfbf",
      "#686868",
      "#e50000",
      "#00d900",
      "#e5e500",
      "#0000ff",
      "#e500e5",
      "#00e5e5",
      "#ffffff"
    ]
  }
}
